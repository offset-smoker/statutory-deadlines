{
    "name": "offset-smoker/pa-business-days",
    "description": "Statutory deadline math for PHP: business days over immutable, timezone-aware dates, US federal and Pennsylvania holiday calendars generated by rule, receipt cutoffs, extensions, and an explanation of every skipped day.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "business-days",
        "deadline",
        "holidays",
        "federal-holidays",
        "pennsylvania",
        "right-to-know",
        "statutory-deadlines",
        "laravel"
    ],
    "authors": [
        {
            "name": "Brandon Wagner",
            "email": "b@wagner.codes"
        }
    ],
    "homepage": "https://github.com/offset-smoker/pa-business-days",
    "support": {
        "issues": "https://github.com/offset-smoker/pa-business-days/issues",
        "source": "https://github.com/offset-smoker/pa-business-days",
        "security": "https://github.com/offset-smoker/pa-business-days/security/policy"
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.24",
        "nesbot/carbon": "^3.8",
        "orchestra/testbench": "^10.12 || ^11.3",
        "pestphp/pest": "^4.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "suggest": {
        "illuminate/support": "For the optional Laravel service provider and facade (Laravel 12 or 13).",
        "nesbot/carbon": "Pass CarbonImmutable dates in and get CarbonImmutable dates back; not required."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "OffsetSmoker\\PaBusinessDays\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OffsetSmoker\\PaBusinessDays\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "OffsetSmoker\\PaBusinessDays\\Laravel\\PaBusinessDaysServiceProvider"
            ],
            "aliases": {
                "Deadlines": "OffsetSmoker\\PaBusinessDays\\Laravel\\Facades\\Deadlines"
            }
        }
    },
    "scripts": {
        "analyse": [
            "phpstan analyse --no-progress --configuration=phpstan-core.neon.dist",
            "phpstan analyse --no-progress --configuration=phpstan.neon.dist"
        ],
        "format": "pint",
        "lint": "pint --test",
        "test": "pest"
    }
}
