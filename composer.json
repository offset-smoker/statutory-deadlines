{
    "name": "offset-smoker/statutory-deadlines",
    "description": "Statutory deadline rules as code: business-day clocks with cited holiday calendars (US federal, Pennsylvania), receipt cutoffs, extensions, and an explanation of every skipped day. Includes the Pennsylvania Right-to-Know Law.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "statutory-deadlines",
        "deadline",
        "business-days",
        "holidays",
        "federal-holidays",
        "pennsylvania",
        "right-to-know",
        "open-records",
        "laravel"
    ],
    "authors": [
        {
            "name": "Brandon Wagner",
            "email": "b@wagner.codes"
        }
    ],
    "homepage": "https://github.com/offset-smoker/statutory-deadlines",
    "support": {
        "issues": "https://github.com/offset-smoker/statutory-deadlines/issues",
        "source": "https://github.com/offset-smoker/statutory-deadlines",
        "security": "https://github.com/offset-smoker/statutory-deadlines/security/policy"
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.24",
        "nesbot/carbon": "^3.8",
        "orchestra/testbench": "^10.12 || ^11.3",
        "pestphp/pest": "^4.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "suggest": {
        "illuminate/support": "For the optional Laravel service provider and facade (Laravel 12 or 13).",
        "nesbot/carbon": "Pass CarbonImmutable dates in and get CarbonImmutable dates back; not required."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "OffsetSmoker\\StatutoryDeadlines\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OffsetSmoker\\StatutoryDeadlines\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "OffsetSmoker\\StatutoryDeadlines\\Laravel\\StatutoryDeadlinesServiceProvider"
            ],
            "aliases": {
                "Deadlines": "OffsetSmoker\\StatutoryDeadlines\\Laravel\\Facades\\Deadlines"
            }
        }
    },
    "scripts": {
        "analyse": [
            "phpstan analyse --no-progress --configuration=phpstan-core.neon.dist",
            "phpstan analyse --no-progress --configuration=phpstan.neon.dist"
        ],
        "format": "pint",
        "lint": "pint --test",
        "test": "pest"
    }
}
